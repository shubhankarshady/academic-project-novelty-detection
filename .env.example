# ==============================================================================
# Academic Project Novelty Detection - Backend Environment Configuration
# ==============================================================================
# Get your free Groq API key at: https://console.groq.com/keys

# Required for on-demand "✨ Generate AI Explanation" (Groq XAI)
GROQ_API_KEY=your_groq_api_key_here


# Optional model selection (default: llama-3.3-70b-versatile)
# Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Optional request timeout in seconds (default: 30.0)
GROQ_TIMEOUT_SECONDS=30.0
